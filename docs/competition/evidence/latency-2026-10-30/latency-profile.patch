+/* Experimental opt-in cap: leave the submitted policy unchanged at zero. */
+static unsigned int sched_qos_slice_cap_us;
+static int __init sched_qos_slice_cap_setup(char *str)
+{
+	unsigned int cap;
+
+	if (kstrtouint(str, 0, &cap) || (cap && (cap < 1000 || cap > 14000)))
+		return 0;
+	sched_qos_slice_cap_us = cap;
+	return 1;
+}
+__setup("sched_qos_slice_cap_us=", sched_qos_slice_cap_setup);
