+static inline u64 sched_entity_slice(struct sched_entity *se)
+{
+	if (sysctl_sched_qos_slice && entity_is_task(se))
+		return qos_to_slice(task_of(se)->qts.in_qos);
+	return sysctl_sched_min_granularity;
