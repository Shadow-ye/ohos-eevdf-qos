+static void eevdf_atomic64_max(atomic64_t *v, s64 val)
+{
+	s64 old = atomic64_read(v);
+
+	while (val > old) {
+		s64 seen = atomic64_cmpxchg(v, old, val);
+
+		if (seen == old)
+			break;
+		old = seen;
+	}
